set(manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "No install manifest. Use the build directory that performed the installation.")
endif()
file(STRINGS "${manifest}" files)
foreach(path IN LISTS files)
    if(NOT IS_ABSOLUTE "${path}" OR NOT path MATCHES "(plasma/applets/org\\.kde\\.plasma\\.lumaribbon\\.so$|plasma/plasmoids/org\\.kde\\.plasma\\.lumaribbon/|doc/lumaribbon/)")
        message(FATAL_ERROR "Unexpected path in Luma Ribbon manifest: ${path}")
    endif()
endforeach()
foreach(path IN LISTS files)
    set(target "$ENV{DESTDIR}${path}")
    if(EXISTS "${target}" OR IS_SYMLINK "${target}")
        message(STATUS "Removing ${target}")
        file(REMOVE "${target}")
    endif()
endforeach()
